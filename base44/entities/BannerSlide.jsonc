{
  "name": "BannerSlide",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "Image URL"
    },
    "caption": {
      "type": "string",
      "description": "Caption text shown on slide"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Show on homepage"
    }
  },
  "required": [
    "image_url"
  ]
}