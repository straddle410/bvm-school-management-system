{
  "name": "HallTicket",
  "type": "object",
  "properties": {
    "hall_ticket_number": {
      "type": "string",
      "description": "Unique hall ticket number (Format: YYCCXX)"
    },
    "exam_type": {
      "type": "string",
      "description": "Exam type ID"
    },
    "student_id": {
      "type": "string",
      "description": "Student database ID"
    },
    "student_name": {
      "type": "string",
      "description": "Student name"
    },
    "roll_number": {
      "type": "number",
      "description": "Roll number"
    },
    "class_name": {
      "type": "string",
      "description": "Class"
    },
    "section": {
      "type": "string",
      "description": "Section"
    },
    "student_photo_url": {
      "type": "string",
      "description": "Student photo URL"
    },
    "academic_year": {
      "type": "string",
      "description": "Academic year"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Generated",
        "Approved",
        "Published"
      ],
      "default": "Draft",
      "description": "Hall ticket workflow status"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Is locked after approval (prevents updates)"
    },
    "generated_by": {
      "type": "string",
      "description": "Generated by (admin email)"
    },
    "approved_by": {
      "type": "string",
      "description": "Approved by (admin email)"
    },
    "published_by": {
      "type": "string",
      "description": "Published by (admin email)"
    },
    "published_date": {
      "type": "string",
      "format": "date-time",
      "description": "When published (ISO 8601)"
    }
  },
  "required": [
    "hall_ticket_number",
    "exam_type",
    "student_id",
    "student_name",
    "class_name",
    "section",
    "academic_year"
  ],
  "rls": {
    "create": false,
    "read": true,
    "update": false,
    "delete": true
  }
}