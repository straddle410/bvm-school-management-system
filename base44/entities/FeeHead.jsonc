{
  "name": "FeeHead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Fee head name (e.g. Tuition Fee, Transport Fee, Library Fee)"
    },
    "description": {
      "type": "string",
      "description": "Description or notes"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Is this fee head active"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}