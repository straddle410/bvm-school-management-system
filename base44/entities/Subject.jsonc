{
  "name": "Subject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Subject name"
    },
    "code": {
      "type": "string",
      "description": "Subject code"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Applicable classes"
    },
    "is_optional": {
      "type": "boolean",
      "default": false,
      "description": "Is optional subject"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}