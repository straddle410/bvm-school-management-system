      "description": "Class name for the override"
    },
    "section": {
      "type": "string",
      "description": "Section for the override"
    },
    "user_id": {
      "type": "string",
      "description": "Staff ID of user who applied override"
    },
    "reason": {
      "type": "string",
      "description": "Reason for override"
    },
    "academic_year": {
      "type": "string",
      "description": "Academic year"
    }
  },
  "required": [
