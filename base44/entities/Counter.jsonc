{
  "name": "Counter",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Counter key (e.g. student_id_2025)"
    },
    "current_value": {
      "type": "number",
      "default": 0,
      "description": "Current counter value"
    }
  },
  "required": [
    "key"
  ]
}