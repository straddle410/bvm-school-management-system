{
  "name": "Send Quiz Notifications to Students",
  "description": "",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Quiz"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_quiz_notifications_to_students",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendQuizNotification",
            "args": {
              "quiz_id": "{{event.entity_id}}",
              "class_name": "{{data.class_name}}",
              "title": "{{data.title}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendQuizNotification"
  }
}